{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    // VS Code's `Webview.postMessage(message)` has no `targetOrigin`: the rule is for `window.postMessage`.
    "unicorn/require-post-message-target-origin": "off"
  },
  "overrides": [
    // Google's TypeScript Style Guide (#134, #133).
    {
      "files": ["**/*.ts", "**/*.mts"],
      "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
      "rules": {
        "eslint/func-style": ["error", "declaration"],
        "eslint/curly": ["error", "multi-line"],
        "eslint/no-underscore-dangle": [
          "error",
          {
            "allowFunctionParams": false
          }
        ],
        "eslint/no-var": "error",
        "eslint/prefer-const": "error",
        "eslint/no-use-before-define": "error",
        "eslint/one-var": ["error", "never"],
        "eslint/no-array-constructor": "error",
        "eslint/no-object-constructor": "error",
        "eslint/guard-for-in": "error",
        "eslint/no-proto": "error",
        "eslint/no-extend-native": "error",
        "eslint/prefer-arrow-callback": "error",
        "eslint/prefer-rest-params": "error",
        "eslint/prefer-spread": "error",
        "eslint/no-multi-str": "error",
        "eslint/prefer-template": "error",
        "eslint/no-implicit-coercion": [
          "error",
          {
            "boolean": false
          }
        ],
        "eslint/no-extra-boolean-cast": "error",
        "eslint/no-cond-assign": "error",
        "eslint/no-throw-literal": "error",
        "eslint/prefer-promise-reject-errors": "error",
        "eslint/no-empty": "error",
        "eslint/eqeqeq": [
          "error",
          "always",
          {
            "null": "ignore"
          }
        ],
        "eslint/no-new-wrappers": "error",
        "eslint/no-debugger": "error",
        "eslint/no-with": "error",
        "eslint/no-eval": "error",
        "eslint/no-new-func": "error",
        "eslint/no-global-assign": "error",
        "import/no-default-export": "error",
        "import/no-mutable-exports": "error",
        "unicorn/filename-case": [
          "error",
          {
            "case": "snakeCase"
          }
        ],
        "unicorn/no-array-callback-reference": "error",
        "unicorn/throw-new-error": "error",
        "unicorn/new-for-builtins": "error",
        "oxc/no-const-enum": "error",
        "typescript/no-namespace": "error",
        "typescript/no-require-imports": "error",
        "typescript/triple-slash-reference": "error",
        "typescript/no-for-in-array": "error",
        "typescript/only-throw-error": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/consistent-type-assertions": [
          "error",
          {
            "assertionStyle": "as",
            "objectLiteralTypeAssertions": "never"
          }
        ],
        "typescript/no-implied-eval": "error",
        "typescript/no-inferrable-types": "error",
        "typescript/consistent-type-definitions": "error",
        "typescript/array-type": [
          "error",
          {
            "default": "array-simple"
          }
        ],
        "typescript/no-explicit-any": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/restrict-plus-operands": [
          "error",
          {
            "allowNullish": false
          }
        ],
        "typescript/no-empty-object-type": "error",
        "typescript/no-wrapper-object-types": "error",
        "typescript/ban-ts-comment": "error",
        "typescript/no-unsafe-type-assertion": "error",
        "typescript/prefer-readonly": "error",
        "typescript/explicit-member-accessibility": [
          "error",
          {
            "accessibility": "no-public"
          }
        ],
        "typescript/dot-notation": "error",
        "typescript/prefer-for-of": "error",
        "typescript/no-this-alias": "error",
        "typescript/no-confusing-void-expression": "error",
        "eslint/default-case": "error",
        "eslint/no-fallthrough": "error",
        "unicorn/no-static-only-class": "error",
        "unicorn/no-null": "error",
        // Deprecated APIs, and the modern form where one exists (asked by Justine, 2026-10-11).
        "typescript/no-deprecated": "error",
        "unicorn/prefer-string-replace-all": "error",
        "unicorn/prefer-set-has": "error",
        "unicorn/prefer-at": "error",
        "unicorn/prefer-structured-clone": "error",
        "unicorn/prefer-node-protocol": "error",
        "unicorn/prefer-dom-node-append": "error",
        "unicorn/prefer-dom-node-remove": "error",
        "unicorn/prefer-dom-node-text-content": "error",
        "unicorn/prefer-dom-node-dataset": "error",
        "unicorn/prefer-modern-dom-apis": "error",
        "unicorn/prefer-modern-math-apis": "error",
        "unicorn/prefer-string-slice": "error",
        "unicorn/prefer-keyboard-event-key": "error",
        "unicorn/prefer-add-event-listener": "error",
        "unicorn/prefer-global-this": "error",
        "unicorn/prefer-array-flat": "error",
        "unicorn/prefer-array-flat-map": "error",
        "unicorn/prefer-code-point": "error",
        "unicorn/prefer-query-selector": "error",
        "unicorn/prefer-string-trim-start-end": "error",
        "unicorn/prefer-math-trunc": "error",
        "unicorn/prefer-number-properties": "error",
        "unicorn/prefer-date-now": "error",
        "unicorn/prefer-regexp-test": "error",
        "unicorn/prefer-includes": "error",
        "unicorn/prefer-string-starts-ends-with": "error",
        "unicorn/prefer-array-find": "error",
        "unicorn/prefer-array-some": "error",
        "unicorn/prefer-array-index-of": "error",
        "unicorn/prefer-optional-catch-binding": "error",
        "unicorn/prefer-negative-index": "error",
        "unicorn/prefer-event-target": "error"
      }
    }
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  }
}
