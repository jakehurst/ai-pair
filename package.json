{
  "name": "ai-pair",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/vscode",
    "release": "node scripts/release.mjs",
    "package": "npm run package -w packages/vscode",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run test:integration -w packages/vscode",
    "typecheck": "tsc -p . && tsc -p packages/vscode/src/webview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faiface/ai-pair.git"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true,
    "fsevents@2.3.3": true
  }
}
