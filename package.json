{
  "name": "ai-pair",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/vscode",
    "release": "node scripts/release.ts",
    "package": "npm run package -w packages/vscode",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run test:integration -w packages/vscode",
    "typecheck": "tsc -p . && tsc -p packages/vscode/src/webview && tsc -p scripts && tsc -p packages/vscode/scripts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:ascii": "node scripts/check_ascii.ts",
    "lint:swift": "swift format lint --strict --recursive packages/vscode/scripts",
    "typecheck:swift": "swiftc -typecheck -warnings-as-errors packages/vscode/scripts/icon.swift",
    "lint:sh": "bash scripts/lint_shell.sh",
    "lint:web": "node scripts/lint_web.ts",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:tla": "node scripts/lint_tla.ts"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@types/node": "~22.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.0",
    "html-validate": "^11.16.0",
    "markdownlint-cli2": "^0.23.3",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "vnu-jar": "^26.9.16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faiface/ai-pair.git"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true,
    "fsevents@2.3.3": true
  }
}
