{
  "name": "ai-pair",
  "displayName": "AI Pair",
  "description": "Pair program with an AI agent: a second cursor that types at a human pace and narrates what it's doing.",
  "version": "0.42.0",
  "publisher": "mattyv",
  "author": {
    "name": "mattyv"
  },
  "private": true,
  "license": "MIT",
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "pair programming",
    "agent",
    "mcp",
    "claude",
    "live coding"
  ],
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F1F1F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "AI Pair lets an agent edit the files in the workspace and run commands in it."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "AI Pair reads and writes the workspace through the file system."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vscode:prepublish": "node scripts/build.mts --production",
    "build": "node scripts/build.mts",
    "test:integration": "bash scripts/integration.sh",
    "test:integration:coverage": "bash scripts/integration.sh --coverage",
    "package": "node scripts/build.mts --production && vsce package --no-dependencies --out ../.."
  },
  "dependencies": {
    "@ai-pair/core": "*",
    "@ai-pair/protocol": "*",
    "jsonc-parser": "^3.3.1",
    "kokoro-js": "^1.2.1"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "aiPair",
          "title": "Pair",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "aiPair": [
        {
          "type": "webview",
          "id": "aiPair.narration",
          "name": "Pair",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "aiPair.copyDiagnostics",
        "title": "Copy Diagnostics",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.setElevenLabsKey",
        "title": "Add or Replace ElevenLabs API Key",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.removeElevenLabsKey",
        "title": "Remove ElevenLabs API Key",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.setUpAgent",
        "title": "Set Up Agent",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.playDemo",
        "title": "Play Demo Session",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.calibrate",
        "title": "Calibrate Reading Speed",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.togglePause",
        "title": "Pause / Resume",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.toggleAttention",
        "title": "Raise / Lower Hand",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.configureShortcuts",
        "title": "Configure Keyboard Shortcuts",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.interrupt",
        "title": "Interrupt",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.toggleTurn",
        "title": "Take / Hand Back the Turn",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.endSession",
        "title": "End Session",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.focusReply",
        "title": "Reply to the Agent",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.askAboutSelection",
        "title": "Ask the Agent About the Selection",
        "category": "AI Pair"
      }
    ],
    "keybindings": [
      {
        "command": "aiPair.togglePause",
        "key": "alt+q",
        "mac": "ctrl+shift+q",
        "when": "aiPair.active"
      },
      {
        "command": "aiPair.toggleAttention",
        "key": "alt+w",
        "mac": "ctrl+shift+w",
        "when": "aiPair.active"
      },
      {
        "command": "aiPair.focusReply",
        "key": "ctrl+alt+space",
        "mac": "ctrl+shift+space",
        "when": "aiPair.active"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aiPair.askAboutSelection",
          "when": "aiPair.active && editorHasSelection",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "aiPair.askAboutSelection",
          "when": "aiPair.active && editorHasSelection"
        },
        {
          "command": "aiPair.togglePause",
          "when": "aiPair.active"
        },
        {
          "command": "aiPair.toggleAttention",
          "when": "aiPair.active"
        },
        {
          "command": "aiPair.interrupt",
          "when": "aiPair.active"
        },
        {
          "command": "aiPair.toggleTurn",
          "when": "aiPair.active"
        },
        {
          "command": "aiPair.endSession",
          "when": "aiPair.active"
        },
        {
          "command": "aiPair.focusReply",
          "when": "aiPair.active"
        }
      ]
    },
    "configuration": {
      "title": "AI Pair",
      "properties": {
        "aiPair.speech.contextEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Allow supported speech models to use recent completed narration and delivery cues."
        },
        "aiPair.speech.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Speak only narration explicitly selected by the agent.",
          "scope": "application"
        },
        "aiPair.speech.provider": {
          "type": "string",
          "enum": [
            "kokoro",
            "elevenlabs",
            "openrouter"
          ],
          "default": "kokoro",
          "description": "Speech provider. ElevenLabs sends selected narration and previews to its service.",
          "scope": "application"
        },
        "aiPair.speech.computeMode": {
          "type": "string",
          "enum": [
            "cpu",
            "auto",
            "gpu"
          ],
          "default": "cpu",
          "description": "Kokoro compute mode. GPU requires verified local setup.",
          "scope": "application"
        },
        "aiPair.speech.openRouterModel": {
          "type": "string",
          "default": "",
          "description": "Selected compatible OpenRouter speech model ID.",
          "scope": "application"
        },
        "aiPair.speech.openRouterVoice": {
          "type": "string",
          "default": "",
          "description": "Selected OpenRouter model voice ID.",
          "scope": "application"
        },
        "aiPair.speech.openRouterZdr": {
          "type": "boolean",
          "default": false,
          "description": "Filter for ZDR routes and request OpenRouter's ZDR policy; account Safety Retention settings still apply.",
          "scope": "application"
        },
        "aiPair.speech.openRouterFormat": {
          "type": "string",
          "enum": [
            "pcm",
            "mp3"
          ],
          "default": "mp3",
          "description": "Audio response format requested from the selected OpenRouter speech model.",
          "scope": "application"
        },
        "aiPair.speech.elevenLabsVoice": {
          "type": "string",
          "default": "",
          "description": "Selected ElevenLabs account voice ID.",
          "scope": "application"
        },
        "aiPair.speech.elevenLabsSpeed": {
          "type": "number",
          "enum": [
            0.75,
            1,
            1.2
          ],
          "default": 1,
          "description": "ElevenLabs speech speed for the next selected narration.",
          "scope": "application"
        },
        "aiPair.speech.voice": {
          "type": "string",
          "enum": [
            "af_heart",
            "am_michael",
            "bf_emma",
            "bm_george"
          ],
          "default": "af_heart",
          "description": "Local voice for the next selected narration.",
          "scope": "application"
        },
        "aiPair.speech.speed": {
          "type": "number",
          "enum": [
            0.75,
            1,
            1.25,
            1.5
          ],
          "default": 1,
          "description": "Local speech speed for the next selected narration.",
          "scope": "application"
        },
        "aiPair.speech.listeningSpeed": {
          "type": "number",
          "enum": [
            0.75,
            0.8,
            0.85,
            0.9,
            0.95,
            1,
            1.05,
            1.1,
            1.15,
            1.2,
            1.25,
            1.3,
            1.35,
            1.4,
            1.45,
            1.5
          ],
          "default": 1,
          "description": "Experimental listening speed for the next selected narration or preview.",
          "scope": "application"
        },
        "aiPair.showTerminalsAutomatically": {
          "type": "boolean",
          "default": false,
          "description": "Show AI Pair command terminals automatically. Hidden terminals are not restored after a workspace reload; terminals without shell integration are shown.",
          "scope": "application"
        },
        "aiPair.commandApprovalSound": {
          "type": "boolean",
          "default": false,
          "description": "Play a short sound when a new command needs your approval.",
          "scope": "application"
        },
        "aiPair.replyBehavior": {
          "type": "string",
          "enum": [
            "interrupt",
            "finishAction"
          ],
          "default": "interrupt",
          "description": "Choose whether replies interrupt immediately or wait for the current action to finish. Stop always interrupts immediately.",
          "scope": "application"
        },
        "aiPair.navigatorCommentary": {
          "type": "string",
          "enum": [
            "quiet",
            "helpful",
            "coach"
          ],
          "enumDescriptions": [
            "Important issues.",
            "Useful observations.",
            "Explanations and connections."
          ],
          "default": "helpful",
          "description": "How much the navigator comments in writing and speech.",
          "scope": "application"
        },
        "aiPair.chatOrder": {
          "type": "string",
          "enum": [
            "newestFirst",
            "oldestFirst"
          ],
          "enumDescriptions": [
            "Newest messages at the top.",
            "Newest messages at the bottom."
          ],
          "default": "newestFirst",
          "description": "The order of messages in the Pair panel.",
          "scope": "application"
        },
        "aiPair.speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.25,
          "maximum": 4,
          "description": "Overall playback speed: typing, pauses, and reading time. The panel's speed menu offers 0.4x to 3x.",
          "scope": "application"
        },
        "aiPair.codePlayback": {
          "type": "string",
          "enum": [
            "typing",
            "lines",
            "blocks"
          ],
          "default": "typing",
          "description": "Show code as typing, individual lines, or bounded blocks. Changes apply to the next typing action.",
          "scope": "application"
        },
        "aiPair.readingSpeed": {
          "type": "number",
          "default": 1,
          "minimum": 0.25,
          "maximum": 4,
          "description": "Reading speed: divides only the pause after each of the agent's messages. The panel's reading menu offers 0.4x to 3x.",
          "scope": "application"
        },
        "aiPair.calibrationPassage": {
          "type": "object",
          "default": {},
          "markdownDescription": "The passage read to calibrate the reading speed: `{ \"title\": ..., \"text\": ..., \"notice\": ... }`. Empty, the built-in one, Comma Gets a Cure. The agent's `calibrate` tool writes it.",
          "scope": "application"
        },
        "aiPair.agentName": {
          "type": "string",
          "default": "Agent",
          "description": "Name shown on the agent's cursor.",
          "scope": "window"
        },
        "aiPair.timing": {
          "type": "object",
          "default": {},
          "markdownDescription": "Calibration: override any playback timing, in milliseconds at normal speed. See `packages/core/src/timing.ts` for every key and its default, e.g. `{ \"afterSelectMs\": 900, \"type\": { \"wordStartMs\": 140 } }`.",
          "scope": "application"
        },
        "aiPair.confirmCommands": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Ask in the Pair panel before running each command the agent plays in the terminal (`run`). Turning this off lets the agent run commands without Claude Code's own permission prompt."
        },
        "aiPair.trace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "The **AI Pair** output always logs each session's interactions at the Info level: statuses, batches, pauses and resumes with their reasons, interrupts, edits, and each report with its size. This also logs every frame between the editor and the agent, and every panel message, at the Info level, which VS Code shows by default. Without it they're at Trace, hidden unless **Developer: Set Log Level** sets it, which a reinstall resets.",
          "scope": "window"
        }
      }
    },
    "colors": [
      {
        "id": "aiPair.cursor",
        "description": "The agent's cursor.",
        "defaults": {
          "dark": "#E8875B",
          "light": "#C2410C",
          "highContrast": "#FF9E6B",
          "highContrastLight": "#9A3412"
        }
      },
      {
        "id": "aiPair.cursorRead",
        "description": "The agent's cursor while it waits for you to read its message.",
        "defaults": {
          "dark": "#FACC15",
          "light": "#B7791F",
          "highContrast": "#FFE14D",
          "highContrastLight": "#7A5C00"
        }
      },
      {
        "id": "aiPair.cursorForeground",
        "description": "Text on the agent cursor's name label.",
        "defaults": {
          "dark": "#1B1B1B",
          "light": "#FFFFFF",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "aiPair.cursorReadForeground",
        "description": "Text on the agent cursor's name label while it waits for you to read its message.",
        "defaults": {
          "dark": "#1B1B1B",
          "light": "#1B1B1B",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "aiPair.selectionBackground",
        "description": "Background of the agent's selection.",
        "defaults": {
          "dark": "#E8875B40",
          "light": "#C2410C2E",
          "highContrast": "#FF9E6B55",
          "highContrastLight": "#9A341240"
        }
      },
      {
        "id": "aiPair.pointBackground",
        "description": "Background of code the agent is pointing at.",
        "defaults": {
          "dark": "#FACC1526",
          "light": "#B7791F20",
          "highContrast": "#FFE14D40",
          "highContrastLight": "#7A5C0030"
        }
      },
      {
        "id": "aiPair.pointBorder",
        "description": "Border of code the agent is pointing at.",
        "defaults": {
          "dark": "#FACC1599",
          "light": "#B7791F99",
          "highContrast": "#FFE14D",
          "highContrastLight": "#7A5C00"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "1.106.0",
    "@vscode/vsce": "^4.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mattyv/ai-pair.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/mattyv/ai-pair#readme",
  "bugs": {
    "url": "https://github.com/mattyv/ai-pair/issues"
  }
}
